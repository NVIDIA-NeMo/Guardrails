#### POLYGRAF PII DETECTION RAILS ####

# INPUT RAILS

define subflow polygraf detect pii on input
  """Check if the user input has PII using Polygraf."""
  $response = execute polygraf_detect_pii(source="input", text=$user_message)

  if $response.is_blocked
    bot inform answer unknown
    stop


# OUTPUT RAILS

define subflow polygraf detect pii on output
  """Check if the bot output has PII using Polygraf."""
  $response = execute polygraf_detect_pii(source="output", text=$bot_message)

  if $response.is_blocked
    bot inform answer unknown
    stop


# RETRIEVAL RAILS

define subflow polygraf detect pii on retrieval
  """Check if the relevant chunks from the knowledge base have any PII using Polygraf."""
  $response = execute polygraf_detect_pii(source="retrieval", text=$relevant_chunks)

  if $response.is_blocked
    $block_message = $config.bot_messages["inform answer unknown"][0]
    $skip_output_rails = True
    create event BotMessage(text=$block_message)
    stop


#### POLYGRAF PII MASKING RAILS ####

# INPUT RAILS

define subflow polygraf mask pii on input
  """Mask any detected PII in the user input using Polygraf."""
  $response = execute polygraf_mask_pii(source="input", text=$user_message)

  if $response.is_transform
    $user_message = $response.transform_text["user_message"]


# OUTPUT RAILS

define subflow polygraf mask pii on output
  """Mask any detected PII in the bot output using Polygraf."""
  $response = execute polygraf_mask_pii(source="output", text=$bot_message)

  if $response.is_transform
    $bot_message = $response.transform_text["bot_message"]


# RETRIEVAL RAILS

define subflow polygraf mask pii on retrieval
  """Mask any detected PII in the relevant chunks from the knowledge base using Polygraf."""
  $response = execute polygraf_mask_pii(source="retrieval", text=$relevant_chunks)

  if $response.is_transform
    $relevant_chunks = $response.transform_text["relevant_chunks"]
