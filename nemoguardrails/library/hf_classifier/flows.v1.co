define bot refuse to respond
  "I'm sorry, I can't respond to that."

define subflow hf classifier check input
  $response = execute hf_classifier_check_input(classifier=$classifier)

  if $response.is_blocked
    if $config.enable_rails_exceptions
      create event InputRailException(message="Input blocked by 'hf classifier check input'.")
    else
      bot refuse to respond
    stop

define subflow hf classifier check output
  $response = execute hf_classifier_check_output(classifier=$classifier)

  if $response.is_blocked
    if $config.enable_rails_exceptions
      create event OutputRailException(message="Output blocked by 'hf classifier check output'.")
    else
      bot refuse to respond
    stop

define subflow hf classifier check retrieval
  $response = execute hf_classifier_check_retrieval(classifier=$classifier)

  if $response.is_transform
    # Return the transformed chunks as the subflow result
    return $response.transform_text["relevant_chunks"]
  else
    # If no transform, return whatever was passed in (or None)
    return $relevant_chunks