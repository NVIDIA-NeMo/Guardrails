"""
Decision Model Integration Flows (Colang 2.x)

The configured endpoint answers typed yes/no questions with probabilities.
The questions, thresholds, endpoint, model, and API-key environment variable
are configured under `rails.config.decision_model`.

Supported features:
- Input checks: ask the configured questions about the user message
- Output checks: ask the configured questions about the bot response
"""

flow decision model check input
  """Guardrail based on decision model answers to the configured input questions."""
  global $user_message
  $result = await DecisionModelCheckAction(source="input", text=$user_message)

  if $result.is_blocked
    if $system.config.enable_rails_exceptions
      send DecisionModelCheckRailException(message="Decision model check triggered on input: " + $result.reason)
    else
      bot refuse to respond
    abort

flow decision model check output
  """Guardrail based on decision model answers to the configured output questions."""
  global $bot_message
  $result = await DecisionModelCheckAction(source="output", text=$bot_message)

  if $result.is_blocked
    if $system.config.enable_rails_exceptions
      send DecisionModelCheckRailException(message="Decision model check triggered on output: " + $result.reason)
    else
      bot refuse to respond
    abort
