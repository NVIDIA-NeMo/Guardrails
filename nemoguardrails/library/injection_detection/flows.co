flow injection detection
  """
  Reject, omit, or sanitize injection attempts from the bot.
  This rail operates on the $bot_message.
  """
  global $bot_message
  $response = await InjectionDetectionAction(text=$bot_message)

  if $response.is_blocked
    if $system.config.enable_rails_exceptions
      send InjectionDetectionRailException(message="Output not allowed. The output was blocked by the 'injection detection' flow.")
    else
      $detections = ", ".join($response.metadata["detections"])
      bot say "I'm sorry, the desired output triggered rule(s) designed to mitigate exploitation of {$detections}."
    abort
  elif $response.is_transform
    if $system.config.enable_rails_exceptions and $response.metadata["is_injection"]
      send InjectionDetectionRailException(message="Output not allowed. The output was blocked by the 'injection detection' flow.")
      abort
    else
      $bot_message = $response.transform_text["bot_message"]
