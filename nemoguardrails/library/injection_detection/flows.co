# OUTPUT RAILS

flow reject injection
  """
  Reject injection attempts
  """
  $injection = await RejectInjectionAction(source="output", text=$bot_message)

  if $injection
    if $system.config.enable_rails_exceptions
      send InjectionDetectionRailException(message="Injection attempt detected. Bot output contained a potential injection attempt.")
    else
      bot refuse to respond
    abort


flow mitigate injection
  """
  Omit or sanitize injection attempts from the bot.
  """
  $bot_message = await MitigateInjectionAction(source="output", text=$bot_message)
