# INPUT RAILS

define subflow detect sensitive data on input
  """Check if the user input has any sensitive data."""
  $response = execute detect_sensitive_data(source="input", text=$user_message)

  if $response.is_blocked
    bot inform answer unknown
    stop


define subflow mask sensitive data on input
  """Mask any sensitive data found in the user input."""
  $response = execute mask_sensitive_data(source="input", text=$user_message)

  if $response.is_transform
    $user_message = $response.transform_text["user_message"]


# OUTPUT RAILS


define subflow detect sensitive data on output
  """Check if the bot output has any sensitive data."""
  $response = execute detect_sensitive_data(source="output", text=$bot_message)

  if $response.is_blocked
    bot inform answer unknown
    stop


define subflow mask sensitive data on output
  """Mask any sensitive data found in the bot output."""
  $response = execute mask_sensitive_data(source="output", text=$bot_message)

  if $response.is_transform
    $bot_message = $response.transform_text["bot_message"]


# RETRIVAL RAILS


define subflow detect sensitive data on retrieval
  """Check if the relevant chunks from the knowledge base have any sensitive data."""
  $response = execute detect_sensitive_data(source="retrieval", text=$relevant_chunks)

  if $response.is_blocked
    bot inform answer unknown
    stop


define subflow mask sensitive data on retrieval
  """Mask any sensitive data found in the relevant chunks from the knowledge base."""
  $response = execute mask_sensitive_data(source="retrieval", text=$relevant_chunks)

  if $response.is_transform
    $relevant_chunks = $response.transform_text["relevant_chunks"]
