# INPUT RAILS

flow detect sensitive data on input
  """Check if the user input has any sensitive data."""
  global $user_message
  $response = await DetectSensitiveDataAction(source="input", text=$user_message)

  if $response.is_blocked
    bot inform answer unknown
    abort


flow mask sensitive data on input
  """Mask any sensitive data found in the user input."""
  global $user_message
  $response = await MaskSensitiveDataAction(source="input", text=$user_message)

  if $response.is_transform
    $user_message = $response.transform_text["user_message"]


# OUTPUT RAILS


flow detect sensitive data on output
  """Check if the bot output has any sensitive data."""
  global $bot_message
  $response = await DetectSensitiveDataAction(source="output", text=$bot_message)

  if $response.is_blocked
    bot inform answer unknown
    abort


flow mask sensitive data on output
  """Mask any sensitive data found in the bot output."""
  global $bot_message
  $response = await MaskSensitiveDataAction(source="output", text=$bot_message)

  if $response.is_transform
    $bot_message = $response.transform_text["bot_message"]


# RETRIEVAL RAILS


flow detect sensitive data on retrieval
  """Check if the relevant chunks from the knowledge base have any sensitive data."""
  global $relevant_chunks
  $response = await DetectSensitiveDataAction(source="retrieval", text=$relevant_chunks)

  if $response.is_blocked
    bot inform answer unknown
    abort


flow mask sensitive data on retrieval
  """Mask any sensitive data found in the relevant chunks from the knowledge base."""
  global $relevant_chunks
  $response = await MaskSensitiveDataAction(source="retrieval", text=$relevant_chunks)

  if $response.is_transform
    $relevant_chunks = $response.transform_text["relevant_chunks"]
