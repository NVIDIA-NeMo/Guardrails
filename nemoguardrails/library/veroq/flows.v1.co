"""
https://docs.veroq.ai

VeroQ Shield — fact-checking guardrail for LLM output.

Extracts claims from the bot response, verifies each against live sources,
and blocks responses that contain contradicted facts.
"""

define subflow veroq check output facts
  """Guardrail based on the VeroQ trust score and claim verdicts."""
  $result = execute call veroq api

  if $result.claims_contradicted > 0
    if $config.enable_rails_exceptions
      create event VeroqFactCheckRailException(message="VeroQ Shield detected contradicted claims in the response.")
    else
      bot inform facts could not be verified
    stop

  if $result.trust_score < 0.7
    if $config.enable_rails_exceptions
      create event VeroqLowTrustRailException(message="VeroQ Shield trust score is below threshold.")
    else
      bot inform answer may be inaccurate
    stop

define bot inform facts could not be verified
  "I'm not confident in the accuracy of that response. Some claims could not be verified against trusted sources."

define bot inform answer may be inaccurate
  "I'm not fully confident in the accuracy of that response. Please verify the information independently."
