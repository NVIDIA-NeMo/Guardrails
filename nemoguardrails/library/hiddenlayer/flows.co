# INPUT RAILS

flow hiddenlayer check input
  """Check the user input with HiddenLayer AI Runtime Security."""
  global $user_message
  $response = await HiddenlayerEvaluateAction(surface="input", text=$user_message)

  if $response.is_blocked
    if $system.config.enable_rails_exceptions
      send HiddenlayerRailException(message="Prompt not allowed. The prompt was blocked by the 'hiddenlayer check input' flow.")
    else
      bot refuse to respond
    abort

  if $response.is_transform
    $user_message = $response.transform_text["user_message"]

# OUTPUT RAILS

flow hiddenlayer check output
  """Check the bot output with HiddenLayer AI Runtime Security."""
  global $bot_message
  $response = await HiddenlayerEvaluateAction(surface="output", text=$bot_message)

  if $response.is_blocked
    if $system.config.enable_rails_exceptions
      send HiddenlayerRailException(message="Response not allowed. The response was blocked by the 'hiddenlayer check output' flow.")
    else
      bot refuse to respond
    abort

  if $response.is_transform
    $bot_message = $response.transform_text["bot_message"]
