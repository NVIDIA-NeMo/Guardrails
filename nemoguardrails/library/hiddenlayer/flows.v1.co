# INPUT RAILS

define subflow hiddenlayer check input
  """Check the user input with HiddenLayer AI Runtime Security."""
  $response = execute hiddenlayer_evaluate(surface="input", text=$user_message)

  if $response.is_blocked
    if $config.enable_rails_exceptions
      create event HiddenlayerRailException(message="Prompt not allowed. The prompt was blocked by the 'hiddenlayer check input' flow.")
    else
      bot refuse to respond
    stop

  if $response.is_transform
    $user_message = $response.transform_text["user_message"]

# OUTPUT RAILS

define subflow hiddenlayer check output
  """Check the bot output with HiddenLayer AI Runtime Security."""
  $response = execute hiddenlayer_evaluate(surface="output", text=$bot_message)

  if $response.is_blocked
    if $config.enable_rails_exceptions
      create event HiddenlayerRailException(message="Response not allowed. The response was blocked by the 'hiddenlayer check output' flow.")
    else
      bot refuse to respond
    stop

  if $response.is_transform
    $bot_message = $response.transform_text["bot_message"]
