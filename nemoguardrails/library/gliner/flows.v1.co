#### GLiNER PII DETECTION RAILS ####

# INPUT RAILS

define subflow gliner detect pii on input
  """Check if the user input has PII using GLiNER."""
  $response = execute gliner_detect_pii(source="input", text=$user_message)

  if $response.is_blocked
    bot refuse to respond
    stop


# OUTPUT RAILS

define subflow gliner detect pii on output
  """Check if the bot output has PII using GLiNER."""
  $response = execute gliner_detect_pii(source="output", text=$bot_message)

  if $response.is_blocked
    bot refuse to respond
    stop


# RETRIEVAL RAILS

define subflow gliner detect pii on retrieval
  """Check if the relevant chunks from the knowledge base have any PII using GLiNER."""
  $response = execute gliner_detect_pii(source="retrieval", text=$relevant_chunks)

  if $response.is_blocked
    bot refuse to respond
    stop


#######################################################


#### GLiNER PII MASKING RAILS ####

# INPUT RAILS

define subflow gliner mask pii on input
  """Mask any detected PII in the user input using GLiNER."""
  $response = execute gliner_mask_pii(source="input", text=$user_message)

  if $response.is_transform
    $user_message = $response.transform_text["user_message"]


# OUTPUT RAILS

define subflow gliner mask pii on output
  """Mask any detected PII in the bot output using GLiNER."""
  $response = execute gliner_mask_pii(source="output", text=$bot_message)

  if $response.is_transform
    $bot_message = $response.transform_text["bot_message"]


# RETRIEVAL RAILS

define subflow gliner mask pii on retrieval
  """Mask any detected PII in the relevant chunks from the knowledge base using GLiNER."""
  $response = execute gliner_mask_pii(source="retrieval", text=$relevant_chunks)

  if $response.is_transform
    $relevant_chunks = $response.transform_text["relevant_chunks"]
