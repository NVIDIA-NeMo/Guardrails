#### GLiNER PII DETECTION RAILS ####

# INPUT RAILS

flow gliner detect pii on input
  """Check if the user input has PII using GLiNER."""
  $response = await GlinerDetectPiiAction(source="input", text=$user_message)

  if $response.is_blocked
    bot refuse to respond
    abort


# OUTPUT RAILS

flow gliner detect pii on output
  """Check if the bot output has PII using GLiNER."""
  $response = await GlinerDetectPiiAction(source="output", text=$bot_message)

  if $response.is_blocked
    bot refuse to respond
    abort


# RETRIEVAL RAILS

flow gliner detect pii on retrieval
  """Check if the relevant chunks from the knowledge base have any PII using GLiNER."""
  $response = await GlinerDetectPiiAction(source="retrieval", text=$relevant_chunks)

  if $response.is_blocked
    bot refuse to respond
    abort


#######################################################


#### GLiNER PII MASKING RAILS ####

# INPUT RAILS

flow gliner mask pii on input
  """Mask any detected PII in the user input using GLiNER."""
  $response = await GlinerMaskPiiAction(source="input", text=$user_message)

  if $response.is_transform
    global $user_message
    $user_message = $response.transform_text["user_message"]


# OUTPUT RAILS

flow gliner mask pii on output
  """Mask any detected PII in the bot output using GLiNER."""
  $response = await GlinerMaskPiiAction(source="output", text=$bot_message)

  if $response.is_transform
    global $bot_message
    $bot_message = $response.transform_text["bot_message"]


# RETRIEVAL RAILS

flow gliner mask pii on retrieval
  """Mask any detected PII in the relevant chunks from the knowledge base using GLiNER."""
  $response = await GlinerMaskPiiAction(source="retrieval", text=$relevant_chunks)

  if $response.is_transform
    global $relevant_chunks
    $relevant_chunks = $response.transform_text["relevant_chunks"]
