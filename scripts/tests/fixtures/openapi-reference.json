{
  "endpoints": {
    "endpoint_challenges.listChallenges": {
      "displayName": "List red teaming challenges",
      "docs": "List registered red teaming challenges. The response structure depends\non the challenges registered by the application.",
      "errors": [],
      "examples": [
        {
          "request": null,
          "response": [
            {
              "category": "jailbreak",
              "description": "Attempt to bypass safety guardrails.",
              "id": "jailbreak-1"
            }
          ]
        }
      ],
      "fullPath": {
        "head": "v1/challenges",
        "parts": []
      },
      "method": "GET",
      "name": "listChallenges"
    },
    "endpoint_chatCompletions.createGuardrailsChatCompletion": {
      "displayName": "Create a guarded chat completion",
      "docs": "Generate a chat completion with guardrails applied.\n\nThe request shape is compatible with the OpenAI Chat Completions API and\naccepts Guardrails-specific options in the `guardrails` object.\n\nTo use Try it with a local server, follow\n[Try the API Locally](/reference/guardrails-api-server/try-it).",
      "errors": [
        "UnprocessableEntityError"
      ],
      "examples": [
        {
          "request": {
            "guardrails": {
              "config_id": "nemotron-3.5-content-safety",
              "options": {
                "llm_params": {
                  "chat_template_kwargs": {
                    "enable_thinking": false
                  }
                }
              }
            },
            "max_tokens": 128,
            "messages": [
              {
                "content": "What is the capital of France?",
                "role": "user"
              }
            ],
            "model": "nvidia/nemotron-3.5-lightning-30b-a3b"
          },
          "response": {
            "choices": [
              {
                "finish_reason": "stop",
                "index": 0,
                "message": {
                  "content": "Paris is the capital of France.",
                  "role": "assistant"
                }
              }
            ],
            "created": 1709424000,
            "guardrails": {
              "config_id": "nemotron-3.5-content-safety"
            },
            "id": "chatcmpl-abc123",
            "model": "nvidia/nemotron-3.5-lightning-30b-a3b",
            "object": "chat.completion"
          }
        },
        {
          "request": {
            "guardrails": {
              "config_id": "nemotron-3.5-content-safety",
              "options": {
                "llm_params": {
                  "chat_template_kwargs": {
                    "enable_thinking": false
                  }
                }
              }
            },
            "max_tokens": 128,
            "messages": [
              {
                "content": "Tell me a short story.",
                "role": "user"
              }
            ],
            "model": "nvidia/nemotron-3.5-lightning-30b-a3b",
            "stream": true
          },
          "response": {
            "choices": [
              {
                "finish_reason": "stop",
                "index": 0,
                "message": {
                  "content": "Paris is the capital of France.",
                  "role": "assistant"
                }
              }
            ],
            "created": 1709424000,
            "guardrails": {
              "config_id": "nemotron-3.5-content-safety"
            },
            "id": "chatcmpl-abc123",
            "model": "nvidia/nemotron-3.5-lightning-30b-a3b",
            "object": "chat.completion"
          }
        }
      ],
      "fullPath": {
        "head": "v1/chat/completions",
        "parts": []
      },
      "method": "POST",
      "name": "createGuardrailsChatCompletion"
    },
    "endpoint_configurations.listRailsConfigs": {
