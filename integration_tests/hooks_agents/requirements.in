# The agents the suite runs: Claude Code, which claude-agent-sdk bundles, and Codex, which openai-codex-cli-bin bundles.
# Neither is a Guardrails dependency, so they aren't in pyproject.toml. Exact pins, so each agent release reaches the
# suite as its own bump. requirements.txt pins these without their dependencies, since the suite only runs the bundled
# binaries, and with hashes, which `make test-hooks-agents` checks as it installs them. Compile it from the repository
# root, which applies the repository's 7-day exclude-newer window:
#
#   uv pip compile --universal --no-deps --generate-hashes integration_tests/hooks_agents/requirements.in \
#     -o integration_tests/hooks_agents/requirements.txt
claude-agent-sdk==0.2.168
openai-codex-cli-bin==0.163.0
