# Canned flows that demonstrate the tool-call guardrail end-to-end inside
# NeMo Guardrails. In a real agent the LLM emits the tool name and arguments;
# here we hard-code them so the example runs deterministically.
#
# The guardrail is `safe_tool_call` (registered in config.py): it authorizes the
# proposed call against policy.py and only then dispatches to the real tool.

define user ask to read a file
  "show me the file"
  "read the source file"
  "open app.py"

define user ask to run a long command
  "run the full test suite"
  "run a long shell command"
  "execute this command"

# Allowed path: dev-alice (a developer) reads a workspace file.
define flow read file
  user ask to read a file
  $result = execute safe_tool_call(tool="read_file", principal_id="dev-alice", path="src/app.py")
  bot $result

# Blocked path: ci-bot lacks the developer role required to run a shell command.
define flow run shell
  user ask to run a long command
  $result = execute safe_tool_call(tool="run_shell", principal_id="ci-bot", command="pytest -q", timeout_seconds=120)
  bot $result
